{
 "id": "chemlab",
 "name": "ChemLab \u2014 the warehouse on your phone",
 "short_name": "ChemLab",
 "description": "A whole chemistry lab from one data file: 118 elements, 581 substances, 424 reactions, 9410 element pairs, the safety guard and the notebook. It runs with no network at all.",
